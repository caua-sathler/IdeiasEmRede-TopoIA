{"exemplos": [{"ref": "data_001", "nota": "exemplo do artigo (Figura 1)", "opiniao": "Destacou que todos os jornalistas presentes estavam em busca da verdade, independentemente de suas preferências políticas.", "atribuido": "Arlindo Chinaglia", "orador": "ARLINDO CHINAGLIA", "rotulo": "não suportada", "cos_s": 0.386, "best_other": 0.783, "melhor_outro": "MARCEL VAN HATTEM", "delta": 0.397, "oradores": [{"nome": "MARCEL VAN HATTEM", "cos": 0.783, "frase": "Inicialmente, cumpre ressaltar que todos os que estão aqui são jornalistas e estão em busca da verdade.", "n_frases": 181}, {"nome": "GLENN EDWARD GREENWALD", "cos": 0.58, "frase": "Acho que a obrigação principal dos jornalistas é evitar ser politizado, ou seja, é não ficar do lado de um partido ou de outro, de esquerda ou de direita.", "n_frases": 121}, {"nome": "GILVAN DA FEDERAL", "cos": 0.566, "frase": "Quero também prestar minha solidariedade a todos aqueles jornalistas que vêm sendo perseguidos.", "n_frases": 29}, {"nome": "MARIO FRIAS", "cos": 0.549, "frase": "Há uma turma aí entende muito bem de mentira e ignora o fato de hoje haver jornalistas cerceados do seu direito, assim como Senadores e Deputados.", "n_frases": 23}, {"nome": "ELI VIEIRA ARAUJO JÚNIOR", "cos": 0.489, "frase": "Prestei atenção detidamente em todas as falas.", "n_frases": 106}, {"nome": "GENERAL GIRÃO", "cos": 0.458, "frase": "Valorizem quem vocês são e busquem a verdade de vocês.", "n_frases": 28}, {"nome": "ARLINDO CHINAGLIA", "cos": 0.386, "frase": "Eu quero falar sobre o trabalho executado pelo jornalista Michael Shellenberger.", "n_frases": 72}], "turnos": [["PRESIDENTE", 20, 0.385], ["ARLINDO CHINAGLIA", 1, 0.171], ["PRESIDENTE", 1, 0.207], ["ARLINDO CHINAGLIA", 9, 0.309], ["PRESIDENTE", 6, 0.198], ["ELI VIEIRA ARAUJO JÚNIOR", 44, 0.353], ["PRESIDENTE", 2, 0.179], ["DAVID ÁGAPE", 72, 0.416], ["PRESIDENTE", 3, 0.185], ["DAVID ÁGAPE", 15, 0.305], ["PRESIDENTE", 4, 0.338], ["GLENN EDWARD GREENWALD", 36, 0.362], ["PRESIDENTE", 2, 0.343