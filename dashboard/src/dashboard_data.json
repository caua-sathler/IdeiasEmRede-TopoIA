   "oradores": [
    {
     "id": "A",
     "cos": 0.788,
     "n_frases": 121,
     "frase": "Mas os jornalistas têm como obrigação defender alguns valores democráticos, principalmente a liberdade de expressão e a imprensa livre, e ser contra a censura.",
     "frase_en": "But journalists have a duty to defend certain democratic values, above all freedom of expression and a free press, and to oppose censorship."
    },
    {
     "id": "B",
     "cos": 0.597,
     "n_frases": 29,
     "frase": "Quero também prestar minha solidariedade a todos aqueles jornalistas que vêm sendo perseguidos.",
     "frase_en": "I also want to express my solidarity with all those journalists who have been persecuted."
    },
    {
     "id": "C",
     "cos": 0.576,
     "n_frases": 181,
     "frase": "Não importa se eu concordo ou se eu discordo da pessoa que tem algo a dizer sobre qualquer assunto, eu quero sempre poder defender a liberdade dessa pessoa de falar sobre aquilo que bem entender.",
     "frase_en": "It does not matter whether I agree or disagree with the person who has something to say on any subject; I always want to be able to defend that person's freedom to speak about whatever they please."
    },
    {
     "id": "D",
     "cos": 0.571,
     "n_frases": 28,
     "frase": "Eu vou encerrar, Presidente, dizendo novamente o seguinte: não podemos admitir que, no nosso País, volte a censura e que matem a nossa democracia em nome de sua defesa.",
     "frase_en": "I will close, Chair, by saying again: we cannot allow censorship to return to our country and our democracy to be killed in the name of defending it."
    },
    {
     "id": "E",
     "cos": 0.554,
     "n_frases": 79,
     "frase": "A ideia de defender a democracia com censura é a forma de desinformação mais grave do mundo. É horrível a ideia de proteger a democracia com censura.",
     "frase_en": "The idea of defending democracy with censorship is the most serious form of disinformation in the world. The idea of protecting democracy with censorship is horrible."
    },
    {
     "id": "F",
     "cos": 0.55,
     "n_frases": 136,
     "frase": "Empresários, jornalistas, jornais, veículos de mídia, influenciadores digitais, artistas e até mesmo religiosos foram censurados e perseguidos pelo TSE durante o período eleitoral.",
     "frase_en": "Business people, journalists, newspapers, media outlets, digital influencers, artists and even religious figures were censored and persecuted by the TSE during the election period."
    },
    {
     "id": "G",
     "cos": 0.548,
     "n_frases": 19,
     "frase": "Agora, a Esquerda está aqui, unida, junto com uma parcela da imprensa, o consórcio da censura, dizendo que é uma afronta à soberania nacional, quando, na verdade, Sr. Presidente, é o contrário.",
     "frase_en": "Now the Left is here, united, together with part of the press, the censorship consortium, saying that it is an affront to national sovereignty when, in fact, Mr. Chair, it is the opposite."
    }
   ]
  }
 ],
